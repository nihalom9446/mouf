# ==============================================================================
# MOUF MEDIA - SERVER & META WHATSAPP CLOUD API CONFIGURATION
# ==============================================================================

# Server Port
PORT=3000

# ------------------------------------------------------------------------------
# META WHATSAPP BUSINESS CLOUD API CREDENTIALS
# (Obtain these from https://developers.facebook.com -> Your App -> WhatsApp)
# ------------------------------------------------------------------------------

# 1. WhatsApp Phone Number ID (NOT your personal phone number, this is the 15-digit ID from Meta App Dashboard)
META_WA_PHONE_NUMBER_ID=your_phone_number_id_here

# 2. WhatsApp Business Cloud API Access Token (System User Permanent Token or Temporary Developer Token)
META_WA_ACCESS_TOKEN=your_meta_access_token_here

# 3. Recipient WhatsApp Number (Where notifications will be sent, including country code with NO spaces, dashes, or leading +)
# Example for India (+91 9995 800 444): 919995800444
META_WA_RECIPIENT_PHONE=919995800444

# 4. Meta Graph API Version (Default: v21.0)
META_WA_API_VERSION=v21.0

# ------------------------------------------------------------------------------
# MESSAGE MODE & TEMPLATE SETTINGS (OPTIONAL)
# ------------------------------------------------------------------------------
# Set to 'true' if using a pre-approved Meta WhatsApp Message Template.
# Set to 'false' to send standard direct text notifications.
META_WA_USE_TEMPLATE=false

# Template name configured in Meta WhatsApp Business Manager (only used if META_WA_USE_TEMPLATE=true)
META_WA_TEMPLATE_NAME=lead_notification

# Template language code (e.g., en_US, en)
META_WA_TEMPLATE_LANG=en_US

# ------------------------------------------------------------------------------
# GOOGLE FORM INTEGRATION
# ------------------------------------------------------------------------------
GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSfkqsyuEPcsgOBmiYz2gowZS7zPcvXoyxMgT_GwCbS7n-dlPQ/formResponse
GOOGLE_FORM_ENTRY_NAME=entry.1538161168
GOOGLE_FORM_ENTRY_PHONE=entry.1563800816
GOOGLE_FORM_ENTRY_EMAIL=entry.2011850232
GOOGLE_FORM_ENTRY_MESSAGE=entry.846611159

